# Normalisation des fins de ligne : LF partout dans le dépôt.
* text=auto eol=lf

# Scripts exécutés sous Linux (conteneur, CI, serveur) : LF obligatoire.
# Un CRLF provoque « \r: command not found » à l'exécution.
*.sh text eol=lf
mvnw text eol=lf

# Scripts Windows : CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Fichiers binaires : jamais convertis.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff2 binary
*.jar binary
*.dump binary
*.age binary
