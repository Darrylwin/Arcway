root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.java]
max_line_length = 120

[*.{yml,yaml,json}]
indent_size = 2

# Markdown : deux espaces en fin de ligne = saut de ligne
[*.md]
trim_trailing_whitespace = false

[Caddyfile]
indent_style = tab

# Scripts batch Windows
[*.{cmd,bat}]
end_of_line = crlf