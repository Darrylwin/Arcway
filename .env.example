# --- Profil Spring -----------------------------------------------------------
SPRING_PROFILES_ACTIVE=local

# --- Conteneur PostgreSQL ---------------------------
# Compte d'amorçage du conteneur. L'application ne l'utilise JAMAIS.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=arcway
POSTGRES_PORT=5432

# --- Accès base de données ---------------------------------------------------
ARCWAY_DB_URL=jdbc:postgresql://localhost:5432/arcway

# Rôle applicatif : sans droit de propriété, soumis à la RLS.
ARCWAY_DB_APP_USER=arcway_app
ARCWAY_DB_APP_PASSWORD=CHANGE_ME

# Rôle de migration : utilisé par Flyway seulement.
ARCWAY_DB_MIGRATOR_USER=arcway_migrator
ARCWAY_DB_MIGRATOR_PASSWORD=CHANGE_ME

# --- JWT ---------------------------------------------------------------------
# Secret HS256, 32 octets minimum. L'application REFUSE de démarrer sinon.
# Générer : openssl rand -base64 48
ARCWAY_JWT_SECRET=CHANGE_ME

# --- HTTP --------------------------------------------------------------------
# Origines CORS autorisées, séparées par des virgules.
ARCWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# URL de base des liens placés dans les emails.
ARCWAY_APP_BASE_URL=http://localhost:3000
# Adresses des proxys de confiance (X-Forwarded-For). Vide en local.
ARCWAY_TRUSTED_PROXIES=
# Port d'Actuator. Vide = même port que l'API (local). Dédié en production.
ARCWAY_MANAGEMENT_PORT=

# --- Emails (Mailpit en local) -----------------------------------------------
ARCWAY_MAIL_HOST=localhost
ARCWAY_MAIL_PORT=1025
ARCWAY_MAIL_FROM=no-reply@arcway.local
ARCWAY_MAIL_USER=
ARCWAY_MAIL_PASSWORD=
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
