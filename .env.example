SPRING_PROFILES_ACTIVE=local

# Base de données
ARCWAY_DB_URL=jdbc:postgresql://localhost:5432/arcway_db
ARCWAY_DB_APP_USER=arcway_app
ARCWAY_DB_APP_PASSWORD=arcway_app_dev_password
ARCWAY_DB_MIGRATOR_USER=arcway_migrator
ARCWAY_DB_MIGRATOR_PASSWORD=arcway_migrator_dev_password

# Sécurité & JWT (Secret de minimum 32 octets)
ARCWAY_JWT_SECRET=dev_jwt_secret_key_must_be_at_least_32_bytes_long_12345

# Application & CORS
ARCWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000
ARCWAY_APP_BASE_URL=http://localhost:3000

# Mail (Mailpit en dev local)
ARCWAY_MAIL_HOST=localhost
ARCWAY_MAIL_PORT=1025
ARCWAY_MAIL_FROM=noreply@arcway.app
