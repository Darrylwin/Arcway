# =============================================================================
# Arcway : variables d'environnement de PRODUCTION
# -----------------------------------------------------------------------------
# Usage : sur le serveur, cp prod.env.example prod.env puis adapter.
#
# - prod.env n'est JAMAIS versionné.
# - Ce fichier ne contient que des noms et des valeurs factices.
# - Les SECRETS ne vont PAS ici : un fichier par secret dans deploy/secrets/.
# - Lu à la fois par le conteneur et par docker compose.
# - Aucune guillemet ni commentaire en fin de ligne : une valeur par ligne.
# =============================================================================

# --- Base de données ------------------------------
ARCWAY_DB_URL=jdbc:postgresql://db.example.com:5432/arcway?sslmode=verify-full&sslrootcert=/etc/arcway/db-ca.pem
ARCWAY_DB_APP_USER=arcway_app
ARCWAY_DB_MIGRATOR_USER=arcway_migrator

# --- HTTP ---------------------------------------------------------------------
# Origines CORS autorisées (séparées par des virgules)
ARCWAY_CORS_ALLOWED_ORIGINS=https://app.example.com
# URL de base des liens des emails
ARCWAY_APP_BASE_URL=https://app.example.com
# IP fixe de Caddy dans le réseau Docker
ARCWAY_TRUSTED_PROXIES=172.28.0.2
# Port d'Actuator : publié sur la boucle locale de l'hôte uniquement
ARCWAY_MANAGEMENT_PORT=9090

# --- Emails --------------------------
ARCWAY_MAIL_HOST=smtp.example.com
ARCWAY_MAIL_PORT=587
ARCWAY_MAIL_FROM=no-reply@example.com

# --- Reverse proxy ------------------------------------------------------------
# Nom de domaine public de l'API
ARCWAY_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com

# --- Ressources du conteneur applicatif ---------------------------
ARCWAY_APP_CPUS=1.0
ARCWAY_APP_MEMORY=1g
